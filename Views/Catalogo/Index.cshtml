@model Portal_Inmobiliario.Models.CatalogoFiltroVm
@using Portal_Inmobiliario.Models
@{
    ViewData["Title"] = "Catálogo";
}
<h2>Catálogo</h2>

<form method="get" class="row g-2 mb-3">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="col-md-3">
        <label class="form-label">Ciudad</label>
        <select asp-for="Ciudad" class="form-select" asp-items="ViewBag.Ciudades">
            <option value="">Todas</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Tipo</label>
        <select asp-for="Tipo" class="form-select" asp-items="ViewBag.Tipos">
            <option value="">Todos</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Precio Min</label>
        <input asp-for="PrecioMin" class="form-control" />
        <span asp-validation-for="PrecioMin" class="text-danger"></span>
    </div>

    <div class="col-md-2">
        <label class="form-label">Precio Max</label>
        <input asp-for="PrecioMax" class="form-control" />
        <span asp-validation-for="PrecioMax" class="text-danger"></span>
    </div>

    <div class="col-md-2">
        <label class="form-label">Dormitorios ≥</label>
        <input asp-for="DormitoriosMin" class="form-control" />
        <span asp-validation-for="DormitoriosMin" class="text-danger"></span>
    </div>

    <div class="col-12 mt-2">
        <button class="btn btn-primary">Filtrar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

@if (!Model.Resultados.Any())
{
    <div class="alert alert-info">No hay resultados con esos filtros.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
        @foreach (var i in Model.Resultados)
        {
            <div class="col">
                <div class="card h-100">
                    <img src="@(!string.IsNullOrEmpty(i.Imagen)? i.Imagen : "https://via.placeholder.com/600x350?text=Inmueble")" class="card-img-top" />
                    <div class="card-body">
                        <h5 class="card-title">@i.Titulo</h5>
                        <p class="mb-1"><strong>@i.Ciudad</strong> — @i.Direccion</p>
                        <p class="mb-1">Tipo: @i.Tipo · M²: @i.MetrosCuadrados</p>
                        <p class="mb-1">Dorm: @i.Dormitorios · Baños: @i.Banos</p>
                        <h6 class="text-primary fw-bold">COP @i.Precio:N0</h6>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@i.Id">Ver detalle</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav class="mt-3">
        <ul class="pagination">
            @{
                var prevDisabled = Model.Page <= 1 ? "disabled" : "";
                var nextDisabled = Model.Page >= Model.TotalPages ? "disabled" : "";
            }
            <li class="page-item @prevDisabled">
                <a class="page-link"
                   asp-route-Ciudad="@Model.Ciudad"
                   asp-route-Tipo="@Model.Tipo"
                   asp-route-PrecioMin="@Model.PrecioMin"
                   asp-route-PrecioMax="@Model.PrecioMax"
                   asp-route-DormitoriosMin="@Model.DormitoriosMin"
                   asp-route-Page="@(Model.Page - 1)"
                   asp-route-PageSize="@Model.PageSize">Anterior</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Página @Model.Page de @Model.TotalPages (@Model.Total)</span></li>
            <li class="page-item @nextDisabled">
                <a class="page-link"
                   asp-route-Ciudad="@Model.Ciudad"
                   asp-route-Tipo="@Model.Tipo"
                   asp-route-PrecioMin="@Model.PrecioMin"
                   asp-route-PrecioMax="@Model.PrecioMax"
                   asp-route-DormitoriosMin="@Model.DormitoriosMin"
                   asp-route-Page="@(Model.Page + 1)"
                   asp-route-PageSize="@Model.PageSize">Siguiente</a>
            </li>
        </ul>
    </nav>
}
